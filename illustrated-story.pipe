{
  "project_id": "8e7f29d2-96e4-4a21-99b9-ee6c336dcdd3",
  "version": 1,
  "source": "input",
  "components": [
    {
      "id": "input",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      }
    },
    {
      "id": "model",
      "provider": "llm_openai",
      "config": {
        "profile": "gpt-4-1",
        "gpt-4-1": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        }
      },
      "input": [
        {
          "lane": "questions",
          "from": "input"
        }
      ]
    },
    {
      "id": "output",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "model"
        }
      ]
    }
  ]
}
