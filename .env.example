# Use the runtime/API endpoint provided with your RocketRide account.
# The Cloud SDK guide lists this endpoint; override for your hackathon environment.
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=replace-with-your-rocketride-key

# This sample explicitly uses your own OpenAI key, separate from RocketRide access.
ROCKETRIDE_OPENAI_KEY=replace-with-your-openai-key

# For an already-running local engine, use its configured key and endpoint:
# ROCKETRIDE_URI=ws://localhost:5565

# HydraDB calls tenants "databases" in its v2 API.
HYDRA_DB_API_KEY=replace-with-your-hydradb-key
HYDRA_DB_TENANT_ID=default-tenant

# Cognee instance URL reachable from RocketRide staging.
COGNEE_BASE_URL=https://your-cognee-instance
COGNEE_API_KEY=replace-with-your-cognee-key
